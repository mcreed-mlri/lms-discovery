# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local — only this example file is tracked.
# For production, set the same variables in the Vercel project dashboard
# (Settings -> Environment Variables).

# --- Supabase (database; prepared for the dashboard phase) ---
# Project URL from Supabase dashboard -> Settings -> API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key (server-only, full database access). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Brightspace LMS integration ---
# Base URL of the Brightspace instance, no trailing slash.
BRIGHTSPACE_BASE_URL=https://your-org.brightspace.com
# OAuth 2.0 app credentials (Brightspace -> Manage Extensibility -> OAuth 2.0).
BRIGHTSPACE_CLIENT_ID=your-oauth-client-id
BRIGHTSPACE_CLIENT_SECRET=your-oauth-client-secret
# Must exactly match the redirect URI registered on the Brightspace OAuth app.
# Local dev: https://localhost:3000/api/auth/brightspace/callback
BRIGHTSPACE_REDIRECT_URI=https://your-deployment-url/api/auth/brightspace/callback
# OAuth scopes requested during login (defaults to this in code if unset).
BRIGHTSPACE_OAUTH_SCOPE=core:*:* content:toc:read
# Legacy ID-Key auth credentials (Brightspace -> Manage Extensibility -> API key tool).
# Only needed if using ID-Key auth instead of OAuth.
BRIGHTSPACE_APP_ID=your-app-id
BRIGHTSPACE_APP_KEY=your-app-key
BRIGHTSPACE_USER_ID=your-user-id
BRIGHTSPACE_USER_KEY=your-user-key
# Optional: a long-lived access token for testing without the OAuth flow.
BRIGHTSPACE_ACCESS_TOKEN=
# Brightspace API versions (defaults exist in code; override only if needed).
BRIGHTSPACE_LP_VERSION=1.49
BRIGHTSPACE_LE_VERSION=1.82

# --- Admin API routes ---
# Shared secret required in the x-admin-secret header for /api/admin/* routes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SYNC_SECRET=
